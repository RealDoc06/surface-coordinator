# Environment for the Surface Coordinator service.
#
# Copy to /etc/surface-coordinator/coordinator.env, mode 0640, owner
# root:surface-coordinator (it may hold SC_API_TOKEN):
#
#   install -d -m 0755 /etc/surface-coordinator
#   install -m 0640 -o root -g surface-coordinator coordinator.env.example /etc/surface-coordinator/coordinator.env
#
# Plain KEY=value lines, no quotes needed, no "export". Restart the service
# after changing anything: systemctl restart coordinator

# Where the server listens. Both the clients' WebSocket connections and the
# web UI and API are served here unless SC_UI_BIND is set. Keep it on loopback
# when a reverse proxy terminates TLS in front of it.
SC_BIND=127.0.0.1:8080

# Serve the web UI and API on a separate address instead of SC_BIND. Leave
# unset behind a single reverse proxy.
#SC_UI_BIND=127.0.0.1:8081

# Directory for the database (coordinator.db) and the cached client updates.
# Must match StateDirectory= and ReadWritePaths= in the unit if you change it.
SC_DATA_DIR=/var/lib/surface-coordinator

# How the web UI and API authenticate: "accounts" (username and password,
# create them with `coordinator account create`) or "token" (one bearer token).
SC_AUTH=accounts

# With SC_AUTH=token only: the token. A random one is generated and printed to
# the journal at every start if this is empty.
#SC_API_TOKEN=

# Mark the session cookie Secure. Set to true when the web UI is reached over
# https:// (behind Caddy or another TLS proxy), so the browser never sends the
# session cookie over plain HTTP. Leave false only for a test without TLS.
SC_SECURE_COOKIES=true

# Devices are marked offline after three missed intervals.
SC_HEARTBEAT_INTERVAL_SECS=10

# Upload signed client builds through the UI or scripts/publish-client.ps1.
# Cached/uploaded builds remain available when GitHub checks are disabled.
SC_NO_UPDATE_CHECK=true

# Serve the web UI from this directory instead of the copy built into the
# binary. Normally unset. The service user needs read access, and ProtectHome
# hides /home.
#SC_UI_DIR=/usr/local/share/surface-coordinator/ui
